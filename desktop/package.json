{
  "name": "syndro-desktop",
  "productName": "Syndro",
  "version": "0.1.0",
  "private": true,
  "description": "Local-network file sharing for Android, Linux and Windows. No cloud, no account, no relay.",
  "author": "Syndro contributors",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run icon && npm run build && electron-builder --win nsis --publish never",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  }
}
